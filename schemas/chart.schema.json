{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "kabu-lab/chart.schema.json",
 "title": "KABU LAB 分析JSON（chart: チャート）",
 "description": "DESIGN.md §5 の共通骨格＋chart型 sections。意味検証は tools/validate.mjs が追加で行う。",
 "type": "object",
 "required": [
  "schema",
  "type",
  "code",
  "name",
  "date",
  "price",
  "summary",
  "sections",
  "terms",
  "insight",
  "sources",
  "missing"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "enum": [
    "kabu-analysis@1"
   ]
  },
  "type": {
   "type": "string",
   "enum": [
    "chart"
   ]
  },
  "code": {
   "type": "string",
   "pattern": "^[0-9][0-9A-Z]{3}$"
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "price": {
   "type": "object",
   "description": "基準価格。シナリオの起点にも使う",
   "required": [
    "close",
    "change",
    "changePct",
    "asOf"
   ],
   "properties": {
    "close": {
     "type": "number",
     "minimum": 0
    },
    "change": {
     "type": "number"
    },
    "changePct": {
     "type": "number"
    },
    "asOf": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   }
  },
  "summary": {
   "type": "string",
   "minLength": 1,
   "maxLength": 60
  },
  "sections": {
   "type": "object",
   "required": [
    "timeframes",
    "levels",
    "heat",
    "checklist",
    "plans",
    "lesson"
   ],
   "properties": {
    "timeframes": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "type": "object",
      "required": [
       "frame",
       "trend",
       "text"
      ],
      "properties": {
       "frame": {
        "type": "string",
        "enum": [
         "monthly",
         "weekly",
         "daily"
        ]
       },
       "trend": {
        "type": "string",
        "enum": [
         "up",
         "flat",
         "down"
        ]
       },
       "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       }
      }
     },
     "description": "月足→週足→日足の順"
    },
    "levels": {
     "type": "array",
     "minItems": 2,
     "maxItems": 12,
     "items": {
      "type": "object",
      "required": [
       "kind",
       "low",
       "high",
       "strength",
       "label",
       "basis"
      ],
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "resistance",
         "support"
        ]
       },
       "low": {
        "type": "number",
        "minimum": 0
       },
       "high": {
        "type": "number",
        "minimum": 0
       },
       "strength": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
       },
       "basis": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
         "type": "string",
         "minLength": 1,
         "maxLength": 12
        }
       }
      }
     },
     "description": "low=high なら線、違えば帯（low<=high）"
    },
    "heat": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": [
       "key",
       "value",
       "state",
       "note"
      ],
      "properties": {
       "key": {
        "type": "string",
        "enum": [
         "ma25dev",
         "rsi",
         "change3d",
         "volume"
        ]
       },
       "value": {
        "type": [
         "number",
         "null"
        ]
       },
       "state": {
        "type": "string",
        "enum": [
         "calm",
         "warm",
         "hot"
        ]
       },
       "note": {
        "type": "string",
        "minLength": 0,
        "maxLength": 60
       }
      }
     },
     "description": "ma25dev→rsi→change3d→volume の順"
    },
    "checklist": {
     "type": "array",
     "minItems": 10,
     "maxItems": 10,
     "items": {
      "type": "object",
      "required": [
       "id",
       "status",
       "reason",
       "watch"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^C(0[1-9]|10)$"
       },
       "status": {
        "type": "string",
        "enum": [
         "done",
         "progress",
         "none"
        ]
       },
       "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
       },
       "watch": {
        "type": "string",
        "minLength": 0,
        "maxLength": 80
       }
      }
     },
     "description": "C01〜C10 の順。watch は status=progress のときだけ書き、他は空文字"
    },
    "plans": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "type": "object",
      "required": [
       "kind",
       "title",
       "when",
       "zone",
       "stop",
       "target",
       "pros",
       "cons"
      ],
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "pullback",
         "breakout",
         "wait"
        ]
       },
       "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
       },
       "when": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       },
       "zone": {
        "type": "object",
        "required": [
         "low",
         "high"
        ],
        "properties": {
         "low": {
          "type": [
           "number",
           "null"
          ],
          "minimum": 0
         },
         "high": {
          "type": [
           "number",
           "null"
          ],
          "minimum": 0
         }
        }
       },
       "stop": {
        "type": "object",
        "required": [
         "price",
         "label"
        ],
        "properties": {
         "price": {
          "type": [
           "number",
           "null"
          ],
          "minimum": 0
         },
         "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
         }
        }
       },
       "target": {
        "type": "object",
        "required": [
         "price",
         "label"
        ],
        "properties": {
         "price": {
          "type": [
           "number",
           "null"
          ],
          "minimum": 0
         },
         "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
         }
        }
       },
       "pros": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       },
       "cons": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       }
      }
     },
     "description": "pullback→breakout→wait の順。「〜なら」という条件つきの考え方"
    },
    "lesson": {
     "type": "object",
     "required": [
      "title",
      "text"
     ],
     "properties": {
      "title": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      }
     }
    }
   }
  },
  "terms": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "term",
     "def"
    ],
    "properties": {
     "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
     },
     "def": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     }
    }
   }
  },
  "insight": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "title",
     "url"
    ],
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   }
  },
  "missing": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 80
   }
  }
 }
}
