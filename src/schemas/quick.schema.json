{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "kabu-lab/quick.schema.json",
 "title": "KABU LAB 分析JSON（quick: クイック診断）",
 "description": "DESIGN.md §5 の共通骨格＋quick型sections。意味検証（checklist順序・diagnosis/scenarios の種別・禁止語）は tools/validate.mjs が追加で行う。",
 "type": "object",
 "required": ["schema", "type", "code", "name", "date", "price", "summary", "sections", "terms", "insight", "sources", "missing"],
 "properties": {
  "schema": { "type": "string", "enum": ["kabu-analysis@1"] },
  "type": { "type": "string", "enum": ["quick"] },
  "code": { "type": "string", "pattern": "^[0-9][0-9A-Z]{3}$" },
  "name": { "type": "string", "minLength": 1, "maxLength": 40 },
  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "price": {
   "type": "object",
   "description": "基準価格。シナリオの起点にも使う",
   "required": ["close", "change", "changePct", "asOf"],
   "properties": {
    "close": { "type": "number", "minimum": 0 },
    "change": { "type": "number" },
    "changePct": { "type": "number" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
   }
  },
  "summary": { "type": "string", "minLength": 1, "maxLength": 60 },
  "sections": {
   "type": "object",
   "required": ["diagnosis", "chart", "performance", "valuation", "scenarios", "margin", "checklist"],
   "properties": {
    "diagnosis": {
     "type": "array", "minItems": 4, "maxItems": 4,
     "items": {
      "type": "object",
      "required": ["key", "label", "level", "verdict", "reason"],
      "properties": {
       "key": { "type": "string", "enum": ["quality", "value", "supply", "trend"] },
       "label": { "type": "string", "minLength": 1, "maxLength": 10 },
       "level": { "type": "number", "minimum": 0, "maximum": 1 },
       "verdict": { "type": "string", "minLength": 1, "maxLength": 12 },
       "reason": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
     }
    },
    "chart": {
     "type": "object",
     "required": ["resistance", "support", "pins"],
     "properties": {
      "resistance": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["price", "label"], "properties": { "price": { "type": "number", "minimum": 0 }, "label": { "type": "string", "maxLength": 30 } } } },
      "support": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["price", "label"], "properties": { "price": { "type": "number", "minimum": 0 }, "label": { "type": "string", "maxLength": 30 } } } },
      "pins": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["date", "label"], "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 20 } } } }
     }
    },
    "performance": {
     "type": "array", "minItems": 1, "maxItems": 3,
     "description": "3期分（取れない期は省く。単位は億円・1株益/配は円）",
     "items": {
      "type": "object",
      "required": ["period", "sales", "profit", "eps", "dividend", "forecast"],
      "properties": {
       "period": { "type": "string", "pattern": "^\\d{4}\\.\\d{1,2}$" },
       "sales": { "type": ["number", "null"] },
       "profit": { "type": ["number", "null"] },
       "eps": { "type": ["number", "null"] },
       "dividend": { "type": ["number", "string", "null"], "maxLength": 20 },
       "forecast": { "type": "boolean" }
      }
     }
    },
    "valuation": {
     "type": "array", "minItems": 1, "maxItems": 3,
     "items": {
      "type": "object",
      "required": ["key", "value", "unit", "ref", "refLabel", "max"],
      "properties": {
       "key": { "type": "string", "enum": ["PER", "PBR", "PSR"] },
       "value": { "type": ["number", "null"], "minimum": 0 },
       "unit": { "type": "string", "maxLength": 4 },
       "ref": { "type": ["number", "null"], "minimum": 0 },
       "refLabel": { "type": "string", "maxLength": 30 },
       "max": { "type": "number", "minimum": 0 }
      }
     }
    },
    "segments": {
     "type": "array", "minItems": 1, "maxItems": 8,
     "items": {
      "type": "object",
      "required": ["name", "profit", "margin", "note"],
      "properties": {
       "name": { "type": "string", "minLength": 1, "maxLength": 30 },
       "profit": { "type": "number" },
       "margin": { "type": ["number", "null"] },
       "note": { "type": "string", "maxLength": 40 }
      }
     }
    },
    "scenarios": {
     "type": "array", "minItems": 3, "maxItems": 3,
     "items": {
      "type": "object",
      "required": ["kind", "title", "text", "target", "breakIf"],
      "properties": {
       "kind": { "type": "string", "enum": ["bull", "base", "bear"] },
       "title": { "type": "string", "minLength": 1, "maxLength": 10 },
       "text": { "type": "string", "minLength": 1, "maxLength": 80 },
       "target": {
        "type": "object",
        "description": "目安。label は表示文、price は単一の目安価格、low/high はレンジ（答え合わせ用）",
        "required": ["label"],
        "properties": {
         "label": { "type": "string", "minLength": 1, "maxLength": 30 },
         "price": { "type": "number", "minimum": 0 },
         "low": { "type": "number", "minimum": 0 },
         "high": { "type": "number", "minimum": 0 }
        }
       },
       "breakIf": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
     }
    },
    "margin": {
     "type": "array", "minItems": 1, "maxItems": 5,
     "description": "信用残 直近5週（古い順・千株）",
     "items": {
      "type": "object",
      "required": ["date", "sell", "buy", "ratio"],
      "properties": {
       "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
       "sell": { "type": ["number", "null"], "minimum": 0 },
       "buy": { "type": ["number", "null"], "minimum": 0 },
       "ratio": { "type": ["number", "null"], "minimum": 0 }
      }
     }
    },
    "checklist": {
     "type": "array", "minItems": 10, "maxItems": 10,
     "description": "schemas/checklist-items.json の C01〜C10 の順",
     "items": {
      "type": "object",
      "required": ["id", "status", "reason"],
      "properties": {
       "id": { "type": "string", "pattern": "^C(0[1-9]|10)$" },
       "status": { "type": "string", "enum": ["done", "progress", "none"] },
       "reason": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
     }
    }
   }
  },
  "terms": {
   "type": "array", "maxItems": 10,
   "items": { "type": "object", "required": ["term", "def"], "properties": { "term": { "type": "string", "minLength": 1, "maxLength": 20 }, "def": { "type": "string", "minLength": 1, "maxLength": 80 } } }
  },
  "insight": { "type": "string", "minLength": 1, "maxLength": 120 },
  "sources": {
   "type": "array", "minItems": 1,
   "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 60 }, "url": { "type": "string", "pattern": "^https?://" } } }
  },
  "missing": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
 }
}
