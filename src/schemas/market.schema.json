{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "kabu-lab/market.schema.json",
 "title": "KABU LAB 分析JSON（market: 市場）",
 "description": "DESIGN.md §5 の共通骨格（code は null・name は「市場」・price は日経平均）＋ §5.4 の sections（§5.9 の edition・§5.10 の sectorNote・themes は任意欄）。保存先は data/market/<実行日>.json（§5.9。2026-10-05 以前は最終取引日）。意味検証（outlook の順序・geo の影響順・gauges の範囲・themes の追い風／向かい風の件数とコードの重複・市場型の断定語）は tools/validate.mjs が追加で行う。",
 "type": "object",
 "required": ["schema", "type", "code", "name", "date", "price", "summary", "sections", "terms", "insight", "sources", "missing"],
 "properties": {
  "schema": { "type": "string", "enum": ["kabu-analysis@1"] },
  "type": { "type": "string", "enum": ["market"] },
  "code": { "type": "null" },
  "name": { "type": "string", "enum": ["市場"] },
  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "price": {
   "type": "object",
   "description": "日経平均の終値と前日比。outlook の基準価格にも使う",
   "required": ["close", "change", "changePct", "asOf"],
   "properties": {
    "close": { "type": "number", "minimum": 0 },
    "change": { "type": "number" },
    "changePct": { "type": "number" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
   }
  },
  "summary": { "type": "string", "minLength": 1, "maxLength": 60 },
  "sections": {
   "type": "object",
   "required": ["level", "outlook", "fx", "rates", "geo", "news", "calendar"],
   "properties": {
    "level": {
     "type": "object",
     "description": "相場の高い安い。position は 0=安い・1=高い",
     "required": ["verdict", "position", "text", "gauges"],
     "properties": {
      "verdict": { "type": "string", "minLength": 1, "maxLength": 12 },
      "position": { "type": "number", "minimum": 0, "maximum": 1 },
      "text": { "type": "string", "minLength": 1, "maxLength": 160 },
      "gauges": {
       "type": "array", "minItems": 2, "maxItems": 4,
       "description": "日経平均の予想PER・200日線からの乖離・52週の値幅の中の位置など。取れたものだけ",
       "items": {
        "type": "object",
        "required": ["key", "label", "value", "unit", "ref", "refLabel", "max"],
        "properties": {
         "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$" },
         "label": { "type": "string", "minLength": 1, "maxLength": 16 },
         "value": { "type": ["number", "null"] },
         "unit": { "type": "string", "maxLength": 4 },
         "ref": { "type": ["number", "null"] },
         "refLabel": { "type": "string", "maxLength": 30 },
         "max": { "type": "number", "minimum": 0 }
        }
       }
      }
     }
    },
    "outlook": {
     "type": "array", "minItems": 3, "maxItems": 3,
     "description": "bull→base→bear の順。quick の scenarios と同じ形。来年末までの日経平均の流れ",
     "items": {
      "type": "object",
      "required": ["kind", "title", "text", "target", "breakIf"],
      "properties": {
       "kind": { "type": "string", "enum": ["bull", "base", "bear"] },
       "title": { "type": "string", "minLength": 1, "maxLength": 10 },
       "text": { "type": "string", "minLength": 1, "maxLength": 80 },
       "target": {
        "type": "object",
        "required": ["label"],
        "properties": {
         "label": { "type": "string", "minLength": 1, "maxLength": 30 },
         "price": { "type": "number", "minimum": 0 },
         "low": { "type": "number", "minimum": 0 },
         "high": { "type": "number", "minimum": 0 }
        }
       },
       "breakIf": { "type": "string", "minLength": 1, "maxLength": 60 }
      }
     }
    },
    "fx": {
     "type": "object",
     "description": "direction: weak=円安方向・strong=円高方向・range=もみ合い",
     "required": ["direction", "text", "effects", "outlook"],
     "properties": {
      "direction": { "type": "string", "enum": ["weak", "strong", "range"] },
      "text": { "type": "string", "minLength": 1, "maxLength": 160 },
      "effects": {
       "type": "array", "minItems": 2, "maxItems": 4,
       "items": {
        "type": "object",
        "required": ["who", "dir", "text"],
        "properties": {
         "who": { "type": "string", "minLength": 1, "maxLength": 16 },
         "dir": { "type": "string", "enum": ["plus", "minus"] },
         "text": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
       }
      },
      "outlook": { "type": "string", "minLength": 1, "maxLength": 160 }
     }
    },
    "rates": {
     "type": "object",
     "required": ["items", "text"],
     "properties": {
      "items": {
       "type": "array", "minItems": 1, "maxItems": 4,
       "items": {
        "type": "object",
        "required": ["key", "label", "value", "unit", "note"],
        "properties": {
         "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,23}$" },
         "label": { "type": "string", "minLength": 1, "maxLength": 16 },
         "value": { "type": ["number", "null"] },
         "unit": { "type": "string", "maxLength": 4 },
         "note": { "type": "string", "maxLength": 40 }
        }
       }
      },
      "text": { "type": "string", "minLength": 1, "maxLength": 160 }
     }
    },
    "geo": {
     "type": "array", "minItems": 5, "maxItems": 5,
     "description": "5件固定・影響の大きい順（level が下がっていく順）",
     "items": {
      "type": "object",
      "required": ["name", "level", "text", "sectors"],
      "properties": {
       "name": { "type": "string", "minLength": 1, "maxLength": 20 },
       "level": { "type": "integer", "minimum": 1, "maximum": 5 },
       "text": { "type": "string", "minLength": 1, "maxLength": 120 },
       "sectors": {
        "type": "array", "minItems": 1, "maxItems": 4,
        "items": {
         "type": "object",
         "required": ["name", "dir"],
         "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 12 },
          "dir": { "type": "string", "enum": ["plus", "minus"] }
         }
        }
       }
      }
     }
    },
    "news": {
     "type": "array", "minItems": 3, "maxItems": 5,
     "items": {
      "type": "object",
      "required": ["title", "text", "dir", "sectors", "url"],
      "properties": {
       "title": { "type": "string", "minLength": 1, "maxLength": 40 },
       "text": { "type": "string", "minLength": 1, "maxLength": 120 },
       "dir": { "type": "string", "enum": ["plus", "minus", "neutral"] },
       "sectors": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 12 } },
       "url": { "type": "string", "pattern": "^https?://" }
      }
     }
    },
    "calendar": {
     "type": "array", "minItems": 0, "maxItems": 5,
     "description": "今後2週間ほどの予定（日付の古い順）",
     "items": {
      "type": "object",
      "required": ["date", "label"],
      "properties": {
       "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
       "label": { "type": "string", "minLength": 1, "maxLength": 30 }
      }
     }
    },
    "edition": {
     "type": "string", "enum": ["pre", "post", "other"],
     "description": "任意（§5.9）。pre＝寄り付き前の版・post＝大引け後の版・other＝それ以外。画面は分析日の横に表示する"
    },
    "sectorNote": {
     "type": "string", "minLength": 1, "maxLength": 160,
     "description": "任意（§5.10）。上がった業種・下がった業種の理由を一言（digest の業種の騰落率とニュースから）"
    },
    "themes": {
     "type": "array", "minItems": 3, "maxItems": 6,
     "description": "任意（§5.10）。追い風（tailwind）2件以上・向かい風（headwind）1件以上（validate.mjs が検査）。注目候補は売買の推奨ではない（理由と崩れる条件を必ず付ける）",
     "items": {
      "type": "object",
      "required": ["name", "dir", "horizon", "sectorKey", "reason", "stocks", "breakIf"],
      "properties": {
       "name": { "type": "string", "minLength": 1, "maxLength": 16 },
       "dir": { "type": "string", "enum": ["tailwind", "headwind"] },
       "horizon": { "type": "string", "enum": ["short", "mid"], "description": "short＝数日〜数週・mid＝数か月" },
       "sectorKey": { "type": ["string", "null"], "pattern": "^16(1[7-9]|2[0-9]|3[0-3])$", "description": "TOPIX-17 業種別ETFのコード（1617〜1633）。該当なしは null" },
       "reason": { "type": "string", "minLength": 1, "maxLength": 120 },
       "stocks": {
        "type": "array", "minItems": 0, "maxItems": 3,
        "description": "そのジャンルの代表的な上場企業（実在のコード。自信のないコードは書かない）",
        "items": {
         "type": "object",
         "required": ["code", "name", "why"],
         "properties": {
          "code": { "type": "string", "pattern": "^[0-9][0-9A-Z]{3}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 20 },
          "why": { "type": "string", "minLength": 1, "maxLength": 60 }
         }
        }
       },
       "breakIf": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
     }
    }
   }
  },
  "terms": {
   "type": "array", "maxItems": 10,
   "items": { "type": "object", "required": ["term", "def"], "properties": { "term": { "type": "string", "minLength": 1, "maxLength": 20 }, "def": { "type": "string", "minLength": 1, "maxLength": 80 } } }
  },
  "insight": { "type": "string", "minLength": 1, "maxLength": 120 },
  "sources": {
   "type": "array", "minItems": 1,
   "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 60 }, "url": { "type": "string", "pattern": "^https?://" } } }
  },
  "missing": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
 }
}
