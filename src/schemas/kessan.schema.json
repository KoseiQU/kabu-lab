{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "kabu-lab/kessan.schema.json",
 "title": "KABU LAB 分析JSON（kessan: 決算）",
 "description": "DESIGN.md §5 の共通骨格＋kessan型 sections。意味検証は tools/validate.mjs が追加で行う。",
 "type": "object",
 "required": [
  "schema",
  "type",
  "code",
  "name",
  "date",
  "price",
  "summary",
  "sections",
  "terms",
  "insight",
  "sources",
  "missing"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "enum": [
    "kabu-analysis@1"
   ]
  },
  "type": {
   "type": "string",
   "enum": [
    "kessan"
   ]
  },
  "code": {
   "type": "string",
   "pattern": "^[0-9][0-9A-Z]{3}$"
  },
  "name": {
   "type": "string",
   "minLength": 1,
   "maxLength": 40
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "price": {
   "type": "object",
   "description": "基準価格。シナリオの起点にも使う",
   "required": [
    "close",
    "change",
    "changePct",
    "asOf"
   ],
   "properties": {
    "close": {
     "type": "number",
     "minimum": 0
    },
    "change": {
     "type": "number"
    },
    "changePct": {
     "type": "number"
    },
    "asOf": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   }
  },
  "summary": {
   "type": "string",
   "minLength": 1,
   "maxLength": 60
  },
  "sections": {
   "type": "object",
   "required": [
    "period",
    "verdict",
    "points",
    "results",
    "driver",
    "progress",
    "margin",
    "outlook",
    "plusMinus",
    "investments",
    "finance",
    "returns",
    "next"
   ],
   "properties": {
    "period": {
     "type": "object",
     "required": [
      "label",
      "announced",
      "docTitle"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30
      },
      "announced": {
       "type": "string",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "docTitle": {
       "type": "string",
       "minLength": 1,
       "maxLength": 60
      }
     }
    },
    "verdict": {
     "type": "object",
     "required": [
      "grade",
      "label",
      "reason"
     ],
     "properties": {
      "grade": {
       "type": "string",
       "enum": [
        "good",
        "normal",
        "bad"
       ]
      },
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 12
      },
      "reason": {
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      }
     },
     "description": "決算の出来の評価（売買の判断ではない）"
    },
    "points": {
     "type": "array",
     "minItems": 3,
     "maxItems": 3,
     "items": {
      "type": "object",
      "required": [
       "title",
       "text"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
       },
       "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
       }
      }
     }
    },
    "results": {
     "type": "array",
     "minItems": 2,
     "maxItems": 6,
     "items": {
      "type": "object",
      "required": [
       "key",
       "label",
       "value",
       "unit",
       "yoyPct",
       "note"
      ],
      "properties": {
       "key": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,19}$"
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
       },
       "value": {
        "type": [
         "number",
         "null"
        ]
       },
       "unit": {
        "type": "string",
        "minLength": 0,
        "maxLength": 6
       },
       "yoyPct": {
        "type": [
         "number",
         "null"
        ]
       },
       "note": {
        "type": "string",
        "minLength": 0,
        "maxLength": 60
       }
      }
     }
    },
    "driver": {
     "type": "object",
     "required": [
      "title",
      "text"
     ],
     "properties": {
      "title": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      }
     }
    },
    "progress": {
     "type": "object",
     "required": [
      "label",
      "pct",
      "pace",
      "note"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30
      },
      "pct": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0,
       "maximum": 200
      },
      "pace": {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      },
      "note": {
       "type": "string",
       "minLength": 0,
       "maxLength": 60
      }
     }
    },
    "margin": {
     "type": "object",
     "required": [
      "label",
      "pct",
      "prevPct",
      "peer"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30
      },
      "pct": {
       "type": [
        "number",
        "null"
       ]
      },
      "prevPct": {
       "type": [
        "number",
        "null"
       ]
      },
      "peer": {
       "type": "string",
       "minLength": 0,
       "maxLength": 60
      }
     }
    },
    "outlook": {
     "type": "object",
     "required": [
      "stance",
      "revision",
      "text",
      "forecast"
     ],
     "properties": {
      "stance": {
       "type": "string",
       "enum": [
        "bullish",
        "neutral",
        "cautious"
       ]
      },
      "revision": {
       "type": "string",
       "enum": [
        "up",
        "none",
        "down"
       ]
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      },
      "forecast": {
       "type": "array",
       "minItems": 1,
       "maxItems": 6,
       "items": {
        "type": "object",
        "required": [
         "label",
         "value",
         "unit",
         "yoyPct"
        ],
        "properties": {
         "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
         },
         "value": {
          "type": [
           "number",
           "null"
          ]
         },
         "unit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6
         },
         "yoyPct": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       }
      }
     }
    },
    "plusMinus": {
     "type": "object",
     "required": [
      "plus",
      "minus"
     ],
     "properties": {
      "plus": {
       "type": "object",
       "required": [
        "title",
        "text"
       ],
       "properties": {
        "title": {
         "type": "string",
         "minLength": 1,
         "maxLength": 30
        },
        "text": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        }
       }
      },
      "minus": {
       "type": "object",
       "required": [
        "title",
        "text"
       ],
       "properties": {
        "title": {
         "type": "string",
         "minLength": 1,
         "maxLength": 30
        },
        "text": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        }
       }
      }
     }
    },
    "investments": {
     "type": "array",
     "minItems": 1,
     "maxItems": 5,
     "items": {
      "type": "object",
      "required": [
       "title",
       "amount",
       "text"
      ],
      "properties": {
       "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
       },
       "amount": {
        "type": [
         "number",
         "null"
        ],
        "description": "億円"
       },
       "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
       }
      }
     }
    },
    "finance": {
     "type": "object",
     "required": [
      "items",
      "verdict",
      "text"
     ],
     "properties": {
      "items": {
       "type": "array",
       "minItems": 1,
       "maxItems": 8,
       "items": {
        "type": "object",
        "required": [
         "label",
         "prev",
         "curr",
         "unit"
        ],
        "properties": {
         "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
         },
         "prev": {
          "type": [
           "number",
           "null"
          ]
         },
         "curr": {
          "type": [
           "number",
           "null"
          ]
         },
         "unit": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6
         }
        }
       }
      },
      "verdict": {
       "type": "string",
       "minLength": 1,
       "maxLength": 30
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 160
      }
     }
    },
    "returns": {
     "type": "object",
     "required": [
      "dividends",
      "eps",
      "buyback"
     ],
     "properties": {
      "dividends": {
       "type": "array",
       "minItems": 1,
       "maxItems": 6,
       "items": {
        "type": "object",
        "required": [
         "period",
         "value",
         "forecast"
        ],
        "properties": {
         "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
         },
         "value": {
          "type": [
           "number",
           "string",
           "null"
          ],
          "maxLength": 20
         },
         "forecast": {
          "type": "boolean"
         }
        }
       }
      },
      "eps": {
       "type": "array",
       "minItems": 1,
       "maxItems": 6,
       "items": {
        "type": "object",
        "required": [
         "period",
         "value",
         "forecast"
        ],
        "properties": {
         "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
         },
         "value": {
          "type": [
           "number",
           "null"
          ]
         },
         "forecast": {
          "type": "boolean"
         }
        }
       }
      },
      "buyback": {
       "type": [
        "string",
        "null"
       ],
       "maxLength": 120
      }
     }
    },
    "segments": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "required": [
       "name",
       "profit",
       "margin",
       "note"
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
       },
       "profit": {
        "type": "number"
       },
       "margin": {
        "type": [
         "number",
         "null"
        ]
       },
       "note": {
        "type": "string",
        "maxLength": 40
       }
      }
     }
    },
    "next": {
     "type": "array",
     "minItems": 1,
     "maxItems": 3,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     }
    },
    "deep": {
     "type": "object",
     "required": [
      "yuho",
      "plan"
     ],
     "properties": {
      "yuho": {
       "type": "object",
       "required": [
        "earner",
        "dragger",
        "oneOff",
        "risks"
       ],
       "properties": {
        "earner": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        },
        "dragger": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        },
        "oneOff": {
         "type": "string",
         "minLength": 0,
         "maxLength": 160
        },
        "risks": {
         "type": "array",
         "minItems": 1,
         "maxItems": 5,
         "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
         }
        }
       }
      },
      "plan": {
       "type": "object",
       "required": [
        "name",
        "goal",
        "targets",
        "consistent",
        "realistic"
       ],
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1,
         "maxLength": 40
        },
        "goal": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        },
        "targets": {
         "type": "array",
         "minItems": 1,
         "maxItems": 6,
         "items": {
          "type": "object",
          "required": [
           "label",
           "target",
           "actual",
           "forecast"
          ],
          "properties": {
           "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
           },
           "target": {
            "type": [
             "number",
             "string",
             "null"
            ],
            "maxLength": 20
           },
           "actual": {
            "type": [
             "number",
             "string",
             "null"
            ],
            "maxLength": 20
           },
           "forecast": {
            "type": [
             "number",
             "string",
             "null"
            ],
            "maxLength": 20
           },
           "unit": {
            "type": "string",
            "maxLength": 6
           },
           "nums": {
            "type": "object",
            "description": "図にするための数値（任意）。目標の下限・上限、実績、今期予想",
            "properties": {
             "targetLow": {
              "type": [
               "number",
               "null"
              ]
             },
             "targetHigh": {
              "type": [
               "number",
               "null"
              ]
             },
             "actual": {
              "type": [
               "number",
               "null"
              ]
             },
             "forecast": {
              "type": [
               "number",
               "null"
              ]
             }
            }
           }
          }
         }
        },
        "consistent": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        },
        "realistic": {
         "type": "string",
         "minLength": 1,
         "maxLength": 160
        }
       }
      }
     },
     "description": "任意（決算 3点）"
    }
   }
  },
  "terms": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "term",
     "def"
    ],
    "properties": {
     "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
     },
     "def": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     }
    }
   }
  },
  "insight": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "title",
     "url"
    ],
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
     },
     "url": {
      "type": "string",
      "pattern": "^https?://"
     }
    }
   }
  },
  "missing": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 80
   }
  }
 }
}