{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "kabu-lab/news.schema.json",
 "title": "KABU LAB 分析JSON（news: ニュース）",
 "description": "DESIGN.md §5 の共通骨格＋ §5.5 の sections。主役の会社1社の分析として data/stocks/<code>/analyses/<最終取引日>-news.json に保存する。意味検証（reaction の騰落率と日付の整合・出典のない事例の数字）は tools/validate.mjs が追加で行う。",
 "type": "object",
 "required": ["schema", "type", "code", "name", "date", "price", "summary", "sections", "terms", "insight", "sources", "missing"],
 "properties": {
  "schema": { "type": "string", "enum": ["kabu-analysis@1"] },
  "type": { "type": "string", "enum": ["news"] },
  "code": { "type": "string", "pattern": "^[0-9][0-9A-Z]{3}$" },
  "name": { "type": "string", "minLength": 1, "maxLength": 40 },
  "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
  "price": {
   "type": "object",
   "required": ["close", "change", "changePct", "asOf"],
   "properties": {
    "close": { "type": "number", "minimum": 0 },
    "change": { "type": "number" },
    "changePct": { "type": "number" },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
   }
  },
  "summary": { "type": "string", "minLength": 1, "maxLength": 60 },
  "sections": {
   "type": "object",
   "required": ["event", "impact", "reaction", "chart", "cases", "related", "takeaway"],
   "properties": {
    "event": {
     "type": "object",
     "description": "何が起きたか。kind は「不祥事」「業績修正」「提携・買収」「規制」「事故」など",
     "required": ["title", "date", "kind", "what"],
     "properties": {
      "title": { "type": "string", "minLength": 1, "maxLength": 40 },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "kind": { "type": "string", "minLength": 1, "maxLength": 12 },
      "what": { "type": "string", "minLength": 1, "maxLength": 160 }
     }
    },
    "impact": {
     "type": "object",
     "description": "duration: short=一時的（数日〜数週）・mid=数か月・long=長引く（1年以上）",
     "required": ["level", "dir", "duration", "text", "factors"],
     "properties": {
      "level": { "type": "integer", "minimum": 1, "maximum": 5 },
      "dir": { "type": "string", "enum": ["plus", "minus", "mixed"] },
      "duration": { "type": "string", "enum": ["short", "mid", "long"] },
      "text": { "type": "string", "minLength": 1, "maxLength": 160 },
      "factors": {
       "type": "array", "minItems": 2, "maxItems": 4,
       "description": "長引くかどうかを分ける要因",
       "items": {
        "type": "object",
        "required": ["label", "dir", "text"],
        "properties": {
         "label": { "type": "string", "minLength": 1, "maxLength": 20 },
         "dir": { "type": "string", "enum": ["better", "worse"] },
         "text": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
       }
      }
     }
    },
    "reaction": {
     "type": "object",
     "description": "出来事の前日の終値（from）から直近（to）まで。数字は digest から",
     "required": ["from", "to", "changePct", "text"],
     "properties": {
      "from": { "type": "object", "required": ["date", "price"], "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "price": { "type": "number", "minimum": 0 } } },
      "to": { "type": "object", "required": ["date", "price"], "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "price": { "type": "number", "minimum": 0 } } },
      "changePct": { "type": "number" },
      "text": { "type": "string", "minLength": 1, "maxLength": 120 }
     }
    },
    "chart": {
     "type": "object",
     "required": ["pins"],
     "properties": {
      "pins": {
       "type": "array", "minItems": 1, "maxItems": 5,
       "items": { "type": "object", "required": ["date", "label"], "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 20 } } }
      }
     }
    },
    "cases": {
     "type": "array", "minItems": 2, "maxItems": 4,
     "description": "過去の似た事例。dropPct・days・recoveryMonths は出典で確認できた数字だけ（無ければ null。url が null なら3つとも null）",
     "items": {
      "type": "object",
      "required": ["name", "year", "dropPct", "days", "recoveryMonths", "outcome", "similar", "different", "url"],
      "properties": {
       "name": { "type": "string", "minLength": 1, "maxLength": 30 },
       "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
       "dropPct": { "type": ["number", "null"] },
       "days": { "type": ["integer", "null"], "minimum": 0 },
       "recoveryMonths": { "type": ["number", "null"], "minimum": 0 },
       "outcome": { "type": "string", "minLength": 1, "maxLength": 80 },
       "similar": { "type": "string", "minLength": 1, "maxLength": 80 },
       "different": { "type": "string", "minLength": 1, "maxLength": 80 },
       "url": { "type": ["string", "null"], "pattern": "^https?://" }
      }
     }
    },
    "related": {
     "type": "array", "minItems": 0, "maxItems": 5,
     "items": {
      "type": "object",
      "required": ["code", "name", "relation", "dir"],
      "properties": {
       "code": { "type": ["string", "null"], "pattern": "^[0-9][0-9A-Z]{3}$" },
       "name": { "type": "string", "minLength": 1, "maxLength": 30 },
       "relation": { "type": "string", "minLength": 1, "maxLength": 20 },
       "dir": { "type": "string", "enum": ["plus", "minus", "neutral"] }
      }
     }
    },
    "takeaway": {
     "type": "object",
     "required": ["text", "checks"],
     "properties": {
      "text": { "type": "string", "minLength": 1, "maxLength": 160 },
      "checks": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }
     }
    }
   }
  },
  "terms": {
   "type": "array", "maxItems": 10,
   "items": { "type": "object", "required": ["term", "def"], "properties": { "term": { "type": "string", "minLength": 1, "maxLength": 20 }, "def": { "type": "string", "minLength": 1, "maxLength": 80 } } }
  },
  "insight": { "type": "string", "minLength": 1, "maxLength": 120 },
  "sources": {
   "type": "array", "minItems": 1,
   "items": { "type": "object", "required": ["title", "url"], "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 60 }, "url": { "type": "string", "pattern": "^https?://" } } }
  },
  "missing": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
 }
}
